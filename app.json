{
  "expo": {
    "name": "Sporttijden",
    "slug": "Sporttijden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios-icon-dark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ios-icon-dark.png",
        "backgroundColor": "#0d960b"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Sporttijden"
    },
    "web": {
      "favicon": "./assets/ios-icon-dark.png"
    },
    "plugins": [
      ["expo-font"],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/ios-icon-dark.png",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
